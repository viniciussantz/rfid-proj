# --- Postgres ---
POSTGRES_DB=rfid
POSTGRES_USER=rfid
POSTGRES_PASSWORD=rfid

# --- Django ---
# Em produção, gere um valor seguro (ex: `python -c "import secrets;print(secrets.token_urlsafe(50))"`)
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1

# --- Superuser automático (opcional) ---
# Deixe vazio para desabilitar.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
